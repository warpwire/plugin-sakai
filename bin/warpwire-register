#!/usr/bin/env bash
#
# Warpwire Sakai plugin - registration tool.
#
# Registers the Warpwire CKEditor plugin in Sakai's deployed
# webapps/library/editor/ckeditor.launch.js. That file belongs to Sakai and is
# replaced by every Sakai upgrade, so re-run `install` after upgrading Sakai
# (e.g. from your deploy or startup automation).
#
# The registration is ONE line, inserted directly after Sakai's own
#   CKEDITOR.plugins.addExternal('contentitem', ...)
# line. It points CKEditor at the plugin in the /warpwire webapp and appends it
# to extraPlugins. The plugin adds its own toolbar button, so the toolbar is not
# edited. The inserted line carries a marker comment, so `uninstall` removes
# exactly that line and restores the file byte-for-byte.
#
# Usage:
#   warpwire-register install   [options]   register (idempotent)
#   warpwire-register uninstall [options]   remove the registration
#   warpwire-register status    [options]   report and verify the installation
#
# Options:
#   --catalina-base DIR   Tomcat base directory (default: $CATALINA_BASE)
#   --launch-file FILE    path to ckeditor.launch.js (overrides --catalina-base)
#   --context PATH        context path the plugin webapp is deployed at
#                         (default: /warpwire)
#   --properties FILE     sakai.properties / local.properties to check in
#                         `status` (default: $CATALINA_BASE/sakai/*.properties)
#   --url URL             base URL of the running Sakai; `status` then checks
#                         the plugin assets are served (e.g. https://lms.example.edu)
#   --dry-run             show what install/uninstall would do; change nothing
#   -h, --help            show this help
#
# Exit status: 0 on success (including "already registered" / "not registered"),
# 1 if a check fails or the target file does not look as expected, 2 on usage
# errors. When it exits non-zero it has not modified any file.

set -euo pipefail

# Stamped by build.sh at release time. "dev" in a source checkout.
TOOL_VERSION="dev"

MARKER="// warpwire-sakai-register"
PLUGIN_NAME="warpwirecontentitem"
ANCHOR_RE="^[[:space:]]*CKEDITOR\.plugins\.addExternal\([[:space:]]*'contentitem'[[:space:]]*,"
REPLACE_RE="CKEDITOR\.replace\("

CMD=""
CATALINA="${CATALINA_BASE:-}"
LAUNCH=""
CONTEXT="/warpwire"
PROPS=""
URL=""
DRY_RUN=0

usage() { sed -n '2,/^set -euo/p' "$0" | sed -e '/^set -euo/d' -e 's/^# \{0,1\}//'; }
die() { echo "warpwire-register: $*" >&2; exit 1; }
usage_error() { echo "warpwire-register: $*" >&2; echo "Run 'warpwire-register --help' for usage." >&2; exit 2; }
say() { echo "[warpwire] $*"; }

while [ $# -gt 0 ]; do
	case "$1" in
		install|uninstall|status) [ -z "$CMD" ] || usage_error "only one command allowed"; CMD="$1" ;;
		--catalina-base) [ $# -ge 2 ] || usage_error "$1 needs a value"; CATALINA="$2"; shift ;;
		--launch-file) [ $# -ge 2 ] || usage_error "$1 needs a value"; LAUNCH="$2"; shift ;;
		--context) [ $# -ge 2 ] || usage_error "$1 needs a value"; CONTEXT="$2"; shift ;;
		--properties) [ $# -ge 2 ] || usage_error "$1 needs a value"; PROPS="$2"; shift ;;
		--url) [ $# -ge 2 ] || usage_error "$1 needs a value"; URL="${2%/}"; shift ;;
		--dry-run) DRY_RUN=1 ;;
		-h|--help) usage; exit 0 ;;
		*) usage_error "unknown argument: $1" ;;
	esac
	shift
done

[ -n "$CMD" ] || usage_error "missing command (install, uninstall or status)"

# Normalize the context path to "/name" with no trailing slash.
CONTEXT="/${CONTEXT#/}"
CONTEXT="${CONTEXT%/}"
case "$CONTEXT" in
	/|*[!A-Za-z0-9/_.-]*) usage_error "invalid --context: $CONTEXT" ;;
esac

if [ -z "$LAUNCH" ]; then
	[ -n "$CATALINA" ] || usage_error "set CATALINA_BASE or pass --catalina-base DIR (or --launch-file FILE)"
	LAUNCH="$CATALINA/webapps/library/editor/ckeditor.launch.js"
fi
[ -f "$LAUNCH" ] || die "ckeditor.launch.js not found at $LAUNCH (is the Sakai library webapp deployed?)"

# The one line we insert. Indentation is copied from the anchor line at insert
# time. [].concat(...) handles extraPlugins being a string (Sakai 25) or an array.
registration_line() {
	printf "%sCKEDITOR.plugins.addExternal('%s', '%s/editor/%s/', 'plugin.js'); ckconfig.extraPlugins = [].concat(ckconfig.extraPlugins || [], '%s').join(','); %s %s" \
		"$1" "$PLUGIN_NAME" "$CONTEXT" "$PLUGIN_NAME" "$PLUGIN_NAME" "$MARKER" "$TOOL_VERSION"
}

# Line numbers (one per line) of lines matching an extended regex / fixed string.
lines_matching() { grep -n -E -- "$1" "$LAUNCH" | cut -d: -f1 || true; }
lines_with_marker() { grep -n -F -- "$MARKER" "$LAUNCH" | cut -d: -f1 || true; }
count_lines() { if [ -z "$1" ]; then echo 0; else printf '%s\n' "$1" | wc -l | tr -d ' '; fi; }

# Checks that the file has the structure the registration relies on. Prints the
# anchor line number on success; dies (writing nothing) otherwise.
check_structure() {
	local anchors n anchor replace_after
	anchors="$(lines_matching "$ANCHOR_RE")"
	n="$(count_lines "$anchors")"
	if [ "$n" != "1" ]; then
		die "expected exactly one \"CKEDITOR.plugins.addExternal('contentitem', ...)\" line in $LAUNCH, found $n. This Sakai version or a local customization is not supported by this tool; nothing was changed."
	fi
	anchor="$anchors"
	replace_after="$(lines_matching "$REPLACE_RE" | awk -v a="$anchor" '$1 > a { print; exit }')"
	[ -n "$replace_after" ] || die "no \"CKEDITOR.replace(\" call after the contentitem registration in $LAUNCH; nothing was changed."
	grep -q "ckconfig" "$LAUNCH" || die "no \"ckconfig\" editor config variable in $LAUNCH; nothing was changed."
	echo "$anchor"
}

# Refuses to touch a file that already mentions the plugin outside our marker
# line (a manual or legacy registration), since we can't remove that safely.
check_no_unmanaged_registration() {
	local unmanaged
	unmanaged="$(grep -n -i -e "$PLUGIN_NAME" "$LAUNCH" | grep -v -F -- "$MARKER" | cut -d: -f1 | tr '\n' ' ' || true)"
	if [ -n "$unmanaged" ]; then
		die "$LAUNCH already references '$PLUGIN_NAME' outside a warpwire-register line (line(s): ${unmanaged% }). This is a manual or legacy registration; restore the original ckeditor.launch.js (or remove those edits) and re-run. Nothing was changed."
	fi
}

# Overwrites $LAUNCH with $1 in place (keeps owner, mode and inode, which also
# keeps bind mounts working).
write_in_place() { cat "$1" > "$LAUNCH"; }

# Prints the current file with line $1 replaced/removed/inserted, byte-exact
# for every other line (head/tail never rewrite untouched bytes).
emit_without_line() { head -n "$(($1 - 1))" "$LAUNCH"; tail -n "+$(($1 + 1))" "$LAUNCH"; }
emit_with_line_after() { head -n "$1" "$LAUNCH"; printf '%s\n' "$2"; tail -n "+$(($1 + 1))" "$LAUNCH"; }

do_install() {
	local anchor indent line markers n tmp
	check_no_unmanaged_registration
	markers="$(lines_with_marker)"
	n="$(count_lines "$markers")"
	[ "$n" -le 1 ] || die "found $n warpwire-register lines in $LAUNCH (expected at most 1); run 'uninstall' first. Nothing was changed."

	if [ "$n" = "1" ]; then
		# Already registered. Check the structure around the existing line: remove
		# it in a scratch copy and validate what remains.
		tmp="$(mktemp)"
		emit_without_line "$markers" > "$tmp"
		LAUNCH_ORIG="$LAUNCH"; LAUNCH="$tmp"
		anchor="$(check_structure)"
		LAUNCH="$LAUNCH_ORIG"
		rm -f "$tmp"
		indent="$(sed -n "${anchor}p" "$LAUNCH" | sed -E 's/^([[:space:]]*).*/\1/')"
		line="$(registration_line "$indent")"
		if [ "$(sed -n "${markers}p" "$LAUNCH")" = "$line" ]; then
			say "already registered in $LAUNCH (context $CONTEXT); nothing to do"
			return 0
		fi
		# Registered by a different tool version or context: replace the line.
		if [ "$DRY_RUN" = 1 ]; then
			say "dry run: would update line $markers of $LAUNCH to:"; echo "$line"; return 0
		fi
		tmp="$(mktemp)"
		{ head -n "$((markers - 1))" "$LAUNCH"; printf '%s\n' "$line"; tail -n "+$((markers + 1))" "$LAUNCH"; } > "$tmp"
		write_in_place "$tmp"; rm -f "$tmp"
		verify_registered "$line"
		say "updated the registration in $LAUNCH (context $CONTEXT, tool $TOOL_VERSION)"
		return 0
	fi

	anchor="$(check_structure)"
	indent="$(sed -n "${anchor}p" "$LAUNCH" | sed -E 's/^([[:space:]]*).*/\1/')"
	line="$(registration_line "$indent")"
	if [ "$DRY_RUN" = 1 ]; then
		say "dry run: would insert after line $anchor of $LAUNCH:"; echo "$line"; return 0
	fi

	cp -p "$LAUNCH" "$LAUNCH.warpwire-backup"
	tmp="$(mktemp)"
	emit_with_line_after "$anchor" "$line" > "$tmp"
	write_in_place "$tmp"; rm -f "$tmp"
	verify_registered "$line"
	# Removing our line must give back the original bytes.
	tmp="$(mktemp)"
	emit_without_line "$(lines_with_marker)" > "$tmp"
	if ! cmp -s "$tmp" "$LAUNCH.warpwire-backup"; then
		write_in_place "$LAUNCH.warpwire-backup"; rm -f "$tmp"
		die "verification failed: the edit changed more than the registration line. Restored the original $LAUNCH."
	fi
	rm -f "$tmp"
	say "registered the Warpwire editor plugin in $LAUNCH (context $CONTEXT, tool $TOOL_VERSION)"
	say "backup of the original file: $LAUNCH.warpwire-backup"
}

verify_registered() {
	local markers
	markers="$(lines_with_marker)"
	[ "$(count_lines "$markers")" = "1" ] && [ "$(sed -n "${markers}p" "$LAUNCH")" = "$1" ] \
		|| die "verification failed: the registration line is not present as expected in $LAUNCH"
}

do_uninstall() {
	local markers n tmp
	markers="$(lines_with_marker)"
	n="$(count_lines "$markers")"
	if [ "$n" = "0" ]; then
		say "not registered in $LAUNCH; nothing to do"
		return 0
	fi
	[ "$n" = "1" ] || die "found $n warpwire-register lines in $LAUNCH (expected 1); remove them by hand. Nothing was changed."
	if [ "$DRY_RUN" = 1 ]; then
		say "dry run: would remove line $markers of $LAUNCH:"; sed -n "${markers}p" "$LAUNCH"; return 0
	fi
	tmp="$(mktemp)"
	emit_without_line "$markers" > "$tmp"
	write_in_place "$tmp"; rm -f "$tmp"
	[ -z "$(lines_with_marker)" ] || die "verification failed: registration line still present in $LAUNCH"
	if [ -f "$LAUNCH.warpwire-backup" ]; then
		if cmp -s "$LAUNCH" "$LAUNCH.warpwire-backup"; then
			say "removed the registration; $LAUNCH is byte-identical to the pre-install backup"
			rm -f "$LAUNCH.warpwire-backup"
		else
			say "removed the registration from $LAUNCH (it differs from $LAUNCH.warpwire-backup, probably because Sakai was upgraded since install; the backup was kept)"
		fi
	else
		say "removed the registration from $LAUNCH"
	fi
	say "also remove the Warpwire scripts from portal.include.extrahead in sakai.properties, and undeploy webapps${CONTEXT}.war"
}

do_status() {
	local failures=0 markers n line webapp props_files f found code path
	ok() { echo "  ok    $*"; }
	bad() { echo "  FAIL  $*"; failures=$((failures + 1)); }
	info() { echo "  info  $*"; }

	say "status (tool $TOOL_VERSION, context $CONTEXT)"

	markers="$(lines_with_marker)"
	n="$(count_lines "$markers")"
	if [ "$n" = "1" ]; then
		line="$(sed -n "${markers}p" "$LAUNCH")"
		case "$line" in
			*"'$CONTEXT/editor/$PLUGIN_NAME/'"*) ok "editor registration present in $LAUNCH (line $markers, ${line##*"$MARKER" })" ;;
			*) bad "editor registration in $LAUNCH points at a different context: $line" ;;
		esac
	elif [ "$n" = "0" ]; then
		bad "editor registration missing from $LAUNCH (run 'warpwire-register install'; re-run after every Sakai upgrade)"
	else
		bad "$n registration lines in $LAUNCH (expected 1)"
	fi
	if grep -n -i -e "$PLUGIN_NAME" "$LAUNCH" | grep -v -q -F -- "$MARKER"; then
		bad "$LAUNCH also has a manual/legacy '$PLUGIN_NAME' registration"
	fi

	if [ -n "$CATALINA" ]; then
		webapp="$CATALINA/webapps${CONTEXT}"
		if [ -f "$webapp/editor/$PLUGIN_NAME/plugin.js" ] && [ -f "$webapp/scripts/warpwire.js" ]; then
			ok "plugin webapp deployed at $webapp"
		elif [ -f "$webapp.war" ]; then
			info "found $webapp.war (not expanded yet; Tomcat expands it on deploy)"
		else
			bad "plugin webapp not found at $webapp or $webapp.war (deploy the release WAR as webapps${CONTEXT}.war)"
		fi
		if [ -d "$CATALINA/webapps/library/editor/ckextraplugins/$PLUGIN_NAME" ] || [ -f "$CATALINA/webapps/portal/scripts/warpwirecontentitem.js" ]; then
			info "legacy plugin files are still inside Sakai's webapps (library/editor/ckextraplugins/$PLUGIN_NAME or portal/scripts); remove them"
		fi
	fi

	if [ -n "$PROPS" ]; then
		props_files="$PROPS"
	elif [ -n "$CATALINA" ]; then
		props_files="$(ls "$CATALINA"/sakai/*.properties 2>/dev/null || true)"
	else
		props_files=""
	fi
	[ -n "$props_files" ] || [ -z "$CATALINA" ] || info "no *.properties found in $CATALINA/sakai (pass --properties FILE if sakai.home is elsewhere)"
	found=""
	for f in $props_files; do
		if grep -E -q "^[[:space:]]*portal\.include\.extrahead[[:space:]]*=.*${CONTEXT}/scripts/warpwire\.js" "$f" 2>/dev/null; then
			found="$f"
		fi
	done
	if [ -n "$found" ]; then
		ok "portal.include.extrahead loads $CONTEXT/scripts/warpwire.js ($found)"
		if grep -E "^[[:space:]]*portal\.include\.extrahead" "$found" | grep -q "WARPWIRE_DEPLOY"; then
			ok "per-deployment config (window.WARPWIRE_DEPLOY) is set in $found"
		else
			info "no inline window.WARPWIRE_DEPLOY config in $found (fine if you load it another way)"
		fi
	elif [ -n "$props_files" ]; then
		bad "no portal.include.extrahead entry loading $CONTEXT/scripts/warpwire.js in: $(echo $props_files)"
	elif [ -z "$CATALINA" ]; then
		info "sakai.properties not checked (pass --properties FILE or --catalina-base DIR)"
	fi

	if [ -n "$URL" ]; then
		if command -v curl >/dev/null 2>&1; then
			for path in "$CONTEXT/editor/$PLUGIN_NAME/plugin.js" "$CONTEXT/scripts/warpwire.js" "$CONTEXT/scripts/warpwirecontentitem.js" "$CONTEXT/editor/$PLUGIN_NAME/html/warpwire.html"; do
				code="$(curl -s -o /dev/null -w '%{http_code}' "$URL$path" || true)"
				if [ "$code" = "200" ]; then ok "served: $URL$path"; else bad "not served (HTTP $code): $URL$path"; fi
			done
		else
			info "curl not found; skipped the HTTP checks"
		fi
	fi

	info "to confirm the browser side (config loaded, LTI tool found), open an editor page with ?wwdebug=1 and check the console for [warpwire] lines"
	if [ "$failures" -gt 0 ]; then
		say "$failures check(s) failed"
		return 1
	fi
	say "all checks passed"
}

case "$CMD" in
	install) do_install ;;
	uninstall) do_uninstall ;;
	status) do_status ;;
esac
